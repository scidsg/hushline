{
  "name": "hushline",
  "version": "0.0.0",
  "private": true,
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build:dev": "webpack --config webpack.config.js --watch",
    "build:prod": "webpack --config webpack.config.js",
    "playwright:e2ee": "playwright test --config=playwright.e2ee.config.js",
    "playwright:pq-protocol": "playwright test --config=playwright.pq-protocol.config.js",
    "playwright:pq-state": "playwright test --config=playwright.pq-state.config.js",
    "playwright:staging": "playwright test --config=playwright.staging.config.js",
    "playwright:visual": "playwright test --config=playwright.visual.config.js",
    "playwright:visual:update": "playwright test --config=playwright.visual.config.js --update-snapshots"
  },
  "dependencies": {
    "@getmaapp/signal-wasm": "0.6.6",
    "openpgp": "npm:@protontech/openpgp@6.3.1"
  },
  "overrides": {
    "serialize-javascript": "^7.0.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.1",
    "css-loader": "^6.7.2",
    "mini-css-extract-plugin": "^2.7.2",
    "prettier": "^3.3.3",
    "sass": "^1.56.2",
    "sass-loader": "^13.2.0",
    "webpack-cli": "^5.0.1"
  }
}
